# Kopier denne fil til .env og udfyld vaerdierne.
# .env er gitignored og maa ALDRIG committes.

# Zwift-kontoen. Bruges af main.py, som sender dem videre til zpdatafetch.
# ZwiftPower har ikke sit eget login - det gaar gennem Zwift.
ZWIFTPOWER_USERNAME=din@email.dk
ZWIFTPOWER_PASSWORD=

# ladder.cycleracing.club er en SELVSTAENDIG konto med sit eget password.
# Den har intet med Zwift-loginet at goere, selvom det kan vaere samme email.
# Bruges af download_teams.py og fetch_team_stats.py.
LADDER_USERNAME=din@email.dk
LADDER_PASSWORD=

# Strava API (strava_*.py). Hentes paa https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=
